<?xml version="1.0" encoding="utf-8"?>
<!--
  Иконка приложения как один самодостаточный вектор — для использования внутри
  интерфейса (заголовок TopAppBar и т.п.). Адаптивную иконку (mipmap/ic_launcher)
  напрямую в Compose не положишь, поэтому здесь собраны оба слоя лаунчера:
  фон + свечение из ic_launcher_background и мотив из ic_launcher_foreground,
  увеличенный из безопасной зоны 72dp так, чтобы целиком влезать в круглую маску.
  В UI обрезается по CircleShape — как маска лаунчера.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- фон: тёмный индиго → фиолетовый -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="108"
                android:endY="108"
                android:startX="0"
                android:startY="0"
                android:type="linear">
                <item android:color="#FF171233" android:offset="0" />
                <item android:color="#FF2C1C63" android:offset="0.5" />
                <item android:color="#FF512E9E" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- мягкое свечение за мотивом -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="43"
                android:gradientRadius="52"
                android:type="radial">
                <item android:color="#8C9B7BFF" android:offset="0" />
                <item android:color="#339B7BFF" android:offset="0.55" />
                <item android:color="#009B7BFF" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- мотив лаунчера: увеличен из безопасной зоны и отцентрован -->
    <group
        android:pivotX="52.125"
        android:pivotY="52.375"
        android:scaleX="1.08"
        android:scaleY="1.08"
        android:translateX="1.875"
        android:translateY="1.625">

        <!-- внешняя пара дуг -->
        <path
            android:fillColor="#00000000"
            android:pathData="M73.09,22.91A27,27 0 0,1 73.09,61.09"
            android:strokeAlpha="0.5"
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round"
            android:strokeWidth="4.8" />
        <path
            android:fillColor="#00000000"
            android:pathData="M34.91,22.91A27,27 0 0,0 34.91,61.09"
            android:strokeAlpha="0.5"
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round"
            android:strokeWidth="4.8" />

        <!-- внутренняя пара дуг -->
        <path
            android:fillColor="#00000000"
            android:pathData="M66.02,29.98A17,17 0 0,1 66.02,54.02"
            android:strokeAlpha="0.92"
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round"
            android:strokeWidth="4.8" />
        <path
            android:fillColor="#00000000"
            android:pathData="M41.98,29.98A17,17 0 0,0 41.98,54.02"
            android:strokeAlpha="0.92"
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round"
            android:strokeWidth="4.8" />

        <!-- излучатель -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M54,34a8,8 0 1,0 0,16a8,8 0 1,0 0,-16z" />

        <!-- эквалайзер -->
        <path android:pathData="M31,72a3.75,3.75 0 0,1 3.75,3.75v6.5a3.75,3.75 0 0,1 -7.5,0v-6.5a3.75,3.75 0 0,1 3.75,-3.75z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:endX="80.75"
                    android:endY="79"
                    android:startX="27.25"
                    android:startY="79"
                    android:type="linear">
                    <item android:color="#FF22D3EE" android:offset="0" />
                    <item android:color="#FF8B93FF" android:offset="0.5" />
                    <item android:color="#FFF472B6" android:offset="1" />
                </gradient>
            </aapt:attr>
        </path>
        <path android:pathData="M42.5,62a3.75,3.75 0 0,1 3.75,3.75v16.5a3.75,3.75 0 0,1 -7.5,0v-16.5a3.75,3.75 0 0,1 3.75,-3.75z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:endX="80.75"
                    android:endY="74"
                    android:startX="27.25"
                    android:startY="74"
                    android:type="linear">
                    <item android:color="#FF22D3EE" android:offset="0" />
                    <item android:color="#FF8B93FF" android:offset="0.5" />
                    <item android:color="#FFF472B6" android:offset="1" />
                </gradient>
            </aapt:attr>
        </path>
        <path android:pathData="M54,60a3.75,3.75 0 0,1 3.75,3.75v18.5a3.75,3.75 0 0,1 -7.5,0v-18.5a3.75,3.75 0 0,1 3.75,-3.75z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:endX="80.75"
                    android:endY="73"
                    android:startX="27.25"
                    android:startY="73"
                    android:type="linear">
                    <item android:color="#FF22D3EE" android:offset="0" />
                    <item android:color="#FF8B93FF" android:offset="0.5" />
                    <item android:color="#FFF472B6" android:offset="1" />
                </gradient>
            </aapt:attr>
        </path>
        <path android:pathData="M65.5,67a3.75,3.75 0 0,1 3.75,3.75v11.5a3.75,3.75 0 0,1 -7.5,0v-11.5a3.75,3.75 0 0,1 3.75,-3.75z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:endX="80.75"
                    android:endY="76.5"
                    android:startX="27.25"
                    android:startY="76.5"
                    android:type="linear">
                    <item android:color="#FF22D3EE" android:offset="0" />
                    <item android:color="#FF8B93FF" android:offset="0.5" />
                    <item android:color="#FFF472B6" android:offset="1" />
                </gradient>
            </aapt:attr>
        </path>
        <path android:pathData="M77,74a3.75,3.75 0 0,1 3.75,3.75v4.5a3.75,3.75 0 0,1 -7.5,0v-4.5a3.75,3.75 0 0,1 3.75,-3.75z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:endX="80.75"
                    android:endY="80"
                    android:startX="27.25"
                    android:startY="80"
                    android:type="linear">
                    <item android:color="#FF22D3EE" android:offset="0" />
                    <item android:color="#FF8B93FF" android:offset="0.5" />
                    <item android:color="#FFF472B6" android:offset="1" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
